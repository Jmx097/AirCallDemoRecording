# Recording control is staged by default. This file contains placeholders only.
RECORDING_CONTROL_MODE=DISABLED
CONTROL_ENABLED=false
RECORDING_CONTROL_HOST=127.0.0.1
RECORDING_CONTROL_PORT=8081
RECORDING_DEPLOYMENT_ID=staging-build-id
RECORDING_CONTROL_POLICY_VERSION=timberline-recording-control-2026-08-02.2
MONDAY_RECORDING_CONSENT_COLUMN_ID=dropdown_mm5v99w5
RECORDING_PILOT_USER_IDS=
RECORDING_PILOT_NUMBER_IDS=
AIRCALL_CONTROL_DATABASE_URL=
MONDAY_API_TOKEN=
AIRCALL_CONTROL_WEBHOOK_TOKEN=
# Independent durable keys; never reuse any value below.
RECORDING_IDEMPOTENCY_HMAC_KEY=
RECORDING_PSEUDONYM_HMAC_KEY=
# Canonical base64-encoded 32-byte AES-256-GCM key and nonsecret ID.
RECORDING_CAPABILITY_ACTIVE_KEY_ID=cap-2026-08
RECORDING_CAPABILITY_ACTIVE_KEY=
# Optional comma-separated key-id:base64-key entries retained only for queued decryption.
RECORDING_CAPABILITY_PREVIOUS_KEYS=
# Public verification key only: canonical base64 Ed25519 SPKI DER.
# Generate and retain the PKCS8 private key only in the offline approval system.
RECORDING_APPROVAL_PUBLIC_KEY=
# Provider credentials are inert unless env is armed AND exact DB activation is valid.
AIRCALL_API_ID=
AIRCALL_API_KEY=
